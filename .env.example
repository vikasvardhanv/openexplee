# OpenExplee Configuration
HOST=0.0.0.0
PORT=8000
DATABASE_PATH=data/openexplee.db

# LLM Providers for AI Research & Copywriting (Add at least one)
# Options: gemini | openai | anthropic | groq | ollama
DEFAULT_LLM_PROVIDER=gemini
DEFAULT_LLM_MODEL=gemini-2.5-flash

# API Keys
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Local Ollama (if using local offline models)
OLLAMA_BASE_URL=http://localhost:11434

# Optional: Serper API Key for Google Search (Falls back to free DuckDuckGo if blank)
SERPER_API_KEY=

# Outreach Deliverability Guardrails
MAX_DAILY_SENDS_PER_INBOX=35
MIN_DELAY_SECONDS=120
MAX_DELAY_SECONDS=300
WARMUP_ENABLED=true
WARMUP_DAILY_TARGET=15

