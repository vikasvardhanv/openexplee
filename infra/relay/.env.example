# Hyvor Relay (vikasvardhanv/relay) Production VPS Config
# Generate APP_SECRET with: openssl rand -hex 32
APP_SECRET=
POSTGRES_PASSWORD=

# Public URL & hostname pointing to your VPS IP
WEB_URL=https://relay.tryviktron.ai
INSTANCE_DOMAIN=relay.tryviktron.ai

# OIDC Login (e.g. Authentik, Keycloak, Google OIDC, or Pocket ID)
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Local Postgres connection (matches compose.yaml)
DATABASE_URL="postgresql://postgres:${POSTGRES_PASSWORD}@127.0.0.1:5432/hyvor_relay?serverVersion=16&charset=utf8"

APP_ENV=prod
LOG_LEVEL=info
